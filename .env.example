# Required — SEC fair-access policy: use a real contact email.
SEC_USER_AGENT=YourApp you@example.com

# Optional — live Nasdaq Data Link fallback when SQLite cache is empty.
# NASDAQ_API_KEY=

# Optional — protect admin routes when exposing the API beyond localhost.
# ADMIN_API_KEY=

# Optional paths and tuning
# STOCK_TRACKER_DB_PATH=data/stock_tracker.sqlite3
# STOCK_TRACKER_DEFAULT_TICKERS=AAPL,MSFT,NVDA
# STOCK_TRACKER_REQUEST_TIMEOUT=20
# STOCK_TRACKER_LOG_DIR=logs
# NLP_DEVICE=auto

# Feature flags (default OFF). Resolution: ENV → SQLite app_config → default.
# Run ./scripts/capabilities.sh for full reference and current resolved state.
# STOCK_TRACKER_FF_EXPERIMENTAL_RESEARCH_QUEUE=true
# STOCK_TRACKER_FF_EXPERIMENTAL_COMPOSITE_RANK=true
# STOCK_TRACKER_FF_EXPERIMENTAL_RESEARCH_COMPOSITE_RANK=true
# STOCK_TRACKER_FF_EMBEDDING_HEAVY_RETAG=true
# STOCK_TRACKER_FF_EXPERIMENTAL_SIGNAL_RANKING=true
# STOCK_TRACKER_FF_EXPERIMENTAL_THESIS_VERSIONING=true
# STOCK_TRACKER_FF_EXPERIMENTAL_BACKTEST_ROUTE=true

# Optional AI orchestration (see orchestration/README.md)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_DEFAULT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
